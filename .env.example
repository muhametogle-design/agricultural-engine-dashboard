# PostgreSQL / Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agri_dss

# Local FastAPI process (Docker Compose overrides the database host to `db`)
AGRI_DATABASE_DSN=postgresql://postgres:postgres@localhost:5432/agri_dss
# Replace before any shared or production deployment (minimum 32 random bytes).
AGRI_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Optional local geospatial datasets
AGRI_TERRAIN__DEM_PATH=data/dem_field.tif
# AGRI_HWSD_RASTER=data/hwsd/hwsd2_somalia.tif
# AGRI_HWSD_ATTRS=data/hwsd/hwsd2_layers.csv

# Live irrigation forecast / policy overrides
AGRI_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
AGRI_FORECAST__MAX_DAYS=16
AGRI_IRRIGATION__EFFECTIVE_RAINFALL_FRACTION=0.80
AGRI_IRRIGATION__HEAT_STRESS_TEMP_C=38
AGRI_IRRIGATION__HEAVY_RAIN_MM=20
AGRI_IRRIGATION__HIGH_WIND_KMH=35
